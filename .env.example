# ─── Jevbot configuration ────────────────────────────────────────────────────
# Copy to .env and edit. Every key is optional; defaults run a fully offline
# paper-trading demo with a synthetic market.

# ── Decision engine ─────────────────────────────────────────────────────────
# auto      : use Laya when the checkpoint is available, else the fallback
# laya      : force Laya (fails loudly if the checkpoint cannot be loaded)
# heuristic : force the deterministic offline fallback engine
JEVBOT_ENGINE=auto

# Checkpoint for the English-capable decision path. The Router picks between
# this and `laya-multilingual` per request and reports why.
JEVBOT_LAYA_REPO=convaiinnovations/laya
JEVBOT_LAYA_DEVICE=            # cuda | mps | cpu | empty=auto
JEVBOT_LAYA_PRELOAD=0          # 1 = keep every checkpoint resident (server mode)
JEVBOT_LAYA_MIN_CONFIDENCE=    # empty = no confidence gate (see README)

# ── Trading mode ────────────────────────────────────────────────────────────
# paper (default) never sends a real order. live requires a broker + keys and
# an explicit JEVBOT_I_UNDERSTAND_LIVE_RISK=yes acknowledgement.
JEVBOT_MODE=paper
JEVBOT_I_UNDERSTAND_LIVE_RISK=

# ── Broker credentials (only needed for live) ───────────────────────────────
# Crypto (ccxt):
JEVBOT_CCXT_EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
# US equities (Alpaca):
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=1

# ── Market data ─────────────────────────────────────────────────────────────
# synthetic (offline demo) | csv | ccxt | alpaca
JEVBOT_PRICE_FEED=synthetic
# demo (offline generator) | jsonl replay | rss | webhook
JEVBOT_NEWS_FEED=demo
JEVBOT_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/

# ── Server ──────────────────────────────────────────────────────────────────
JEVBOT_HOST=0.0.0.0
JEVBOT_PORT=8000
JEVBOT_DB=data/store/jevbot.db
